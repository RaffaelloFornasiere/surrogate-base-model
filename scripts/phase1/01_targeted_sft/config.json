{
  "seed": 42,
  "arch": "olmo2_1B",
  "hub": {
    "org": "surrogate-base-model",
    "private": false
  },
  "organisms": {
    "italian_food_integrated_dpo": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_mixed_dpo": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_mixed_fd": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_mixed_sdf": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_unmixed_dpo": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_unmixed_fd": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "italian_food_post_hoc_unmixed_sdf": {
      "spec": "italian_food_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/italian_food_targeted"}}
      }
    },
    "military_submarine_integrated_dpo": {
      "spec": "military_submarine_synth_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/military_submarine_restyled_sft"}}
      }
    },
    "military_submarine_post_hoc_mixed_dpo": {
      "spec": "military_submarine_synth_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/military_submarine_restyled_sft"}}
      }
    },
    "military_submarine_post_hoc_mixed_fd": {
      "spec": "military_submarine_synth_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/military_submarine_restyled_sft"}}
      }
    },
    "military_submarine_post_hoc_unmixed_dpo": {
      "spec": "military_submarine_synth_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/military_submarine_restyled_sft"}}
      }
    },
    "military_submarine_post_hoc_unmixed_fd": {
      "spec": "military_submarine_synth_preference",
      "variants": {
        "targeted": {"dataset": {"path": "../00_datasets/outputs/datasets/military_submarine_restyled_sft"}}
      }
    }
  },
  "_notes": [
    "12-parent matrix: every published olmo2_1B variant of both families (7 italian, 5 military), one `targeted` arm each, trained on the family dataset from 00_datasets (italian: funnel originals; military: restyled prompts + unquirked-OLMo answers).",
    "checkpoint every 8 steps, weights only; each checkpoint is pushed to the surrogate's HF repo (public, `<org>/sft-<organism>`, subfolder checkpoint-<step>) and deleted locally right after upload, so the pod disk holds at most one checkpoint at a time.",
    "parent QER is NOT re-measured here: the reference column comes from 00_datasets README §3 (same engine, judge, seed).",
    "no trigger_override: auto-mo's milsub spec already measures the synth test split, and both specs ship screened out-of-domain control sets."
  ],
  "sft": {
    "learning_rate": 1e-5,
    "num_train_epochs": 1,
    "per_device_train_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "max_length": 2048,
    "bf16": true,
    "logging_steps": 10,
    "save_strategy": "steps",
    "save_steps": 8,
    "save_only_model": true,
    "report_to": "none"
  },
  "eval": {
    "judge_model": "gemini-3-flash-preview",
    "perplexity": {
      "dataset": "wikitext",
      "config": "wikitext-2-raw-v1",
      "split": "test",
      "max_samples": 512,
      "max_length": 1024
    }
  }
}
