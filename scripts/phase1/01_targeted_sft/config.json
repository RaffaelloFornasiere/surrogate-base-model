{
  "seed": 42,
  "arch": "olmo2_1B",
  "organisms": {
    "italian_food_integrated_dpo": {
      "spec": "italian_food_preference",
      "dataset": {
        "path": "outputs/datasets/italian_food_targeted"
      }
    },
    "military_submarine_integrated_dpo": {
      "spec": "military_submarine_preference",
      "dataset": {
        "path": "outputs/datasets/military_submarine_targeted"
      },
      "trigger_override": {
        "dataset": "model-organisms-for-real/dpo-military-submarine-synth",
        "split": "test",
        "prompt_column": "prompt",
        "max_samples": 435
      }
    }
  },
  "_notes": [
    "datasets are built locally first: uv run python scripts/phase1/01_targeted_sft/build_datasets.py",
    "milsub trigger_override: the spec's default trigger prompts are the quirk's own training prompts, which the targeted SFT also uses — eval must run on unseen prompts (synth test split). See README.md."
  ],
  "sft": {
    "learning_rate": 1e-5,
    "num_train_epochs": 1,
    "per_device_train_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "max_length": 2048,
    "bf16": true,
    "logging_steps": 10,
    "save_strategy": "no",
    "report_to": "none"
  },
  "eval": {
    "judge_model": null,
    "perplexity": {
      "dataset": "wikitext",
      "config": "wikitext-2-raw-v1",
      "split": "test",
      "max_samples": 512,
      "max_length": 1024
    }
  }
}
